# ============================================
# AutoPay Nigeria — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ---- App ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
POSTGRES_DB=autopay_nigeria
POSTGRES_USER=autopay_user
POSTGRES_PASSWORD=autopay_secret_2024
DATABASE_URL=postgresql://autopay_user:autopay_secret_2024@localhost:5432/autopay_nigeria

# ---- Redis ----
REDIS_PASSWORD=autopay_redis_2024
REDIS_URL=redis://:autopay_redis_2024@localhost:6379

# ---- JWT ----
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Interswitch API (Quickteller v5) ----
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
INTERSWITCH_BASE_URL=https://qa.interswitchng.com
INTERSWITCH_TERMINAL_ID=
INTERSWITCH_PAYMENT_ITEM_ID=
INTERSWITCH_MOCK_MODE=true

# ---- Interswitch Source Account (for TransferFunds) ----
INTERSWITCH_SOURCE_ACCOUNT_NUMBER=
INTERSWITCH_SOURCE_ACCOUNT_NAME=
INTERSWITCH_SOURCE_BANK_CODE=

# ---- SendGrid (Email) ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@autopaynigeria.com
SENDGRID_FROM_NAME=AutoPay Nigeria

# ---- Termii (SMS) ----
TERMII_API_KEY=
TERMII_SENDER_ID=AutoPay
TERMII_BASE_URL=https://api.ng.termii.com

# ---- Encryption ----
ENCRYPTION_KEY=your-32-char-encryption-key-here

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
